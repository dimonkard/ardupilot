# ============================================================
# FK723M1-ZGT6
# STM32H723ZGT6
# ============================================================

MCU STM32H7xx STM32H723xx

OSCILLATOR_HZ 25000000
FLASH_SIZE_KB 1024

# ОСТАВЬ ЗДЕСЬ СВОИ РАБОЧИЕ значения APJ_BOARD_ID
# и FLASH/bootloader layout из предыдущего hwdef.


# ------------------------------------------------------------
# SWD
# ------------------------------------------------------------

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD


# ------------------------------------------------------------
# USB
# ------------------------------------------------------------

PA11 OTG_HS_DM OTG1
PA12 OTG_HS_DP OTG1

SERIAL_ORDER OTG1

# No USART/UART yet; USB CDC is a separate driver
define HAL_USE_SERIAL FALSE


# ------------------------------------------------------------
# LED
# ------------------------------------------------------------

PG7 LED_STATUS OUTPUT HIGH

define HAL_GPIO_PIN_LED HAL_GPIO_PIN_LED_STATUS
define HAL_LED_ON 0


# ============================================================
# MPU6050 / I2C2
# ============================================================

# ArduPilot I2C bus 0 = STM32 I2C2
I2C_ORDER I2C2

PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# MPU6050 is a fixed/internal sensor
define HAL_I2C_INTERNAL_MASK 1

# AD0 -> GND => address 0x68
IMU Invensense I2C:0:0x68 ROTATION_NONE


# ------------------------------------------------------------
# No barometer yet
# ------------------------------------------------------------

define HAL_BARO_ALLOW_INIT_NO_BARO 1


# ------------------------------------------------------------
# ADC
# ------------------------------------------------------------

define HAL_USE_ADC FALSE


# ------------------------------------------------------------
# Reduce firmware
# ------------------------------------------------------------

include ../include/minimize_features.inc

define HAL_LOGGING_ENABLED 0
define AP_RANGEFINDER_ENABLED 0
define AP_OPTICALFLOW_ENABLED 0
define AC_PRECLAND_ENABLED 0
define AP_FENCE_ENABLED 0
